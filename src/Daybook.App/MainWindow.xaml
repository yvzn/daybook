<Window x:Class="Daybook.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daybook" Width="600" Height="600" MinWidth="420" MinHeight="400"
        Background="{StaticResource SurfacePrimaryBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabs: where am I, where can I go -->
        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,6,24,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Today" Style="{StaticResource TabButton}"
                        Command="{Binding ShowTodayCommand}" Tag="{Binding IsTodayTab}" />
                <Button Content="Standup" Style="{StaticResource TabButton}"
                        Command="{Binding ShowStandupCommand}" Tag="{Binding IsStandupTab}" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- Toast: "Bob removed · Undo" -->
        <Border Grid.Row="1" DataContext="{Binding Toast}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                Background="{StaticResource TextPrimaryBrush}" CornerRadius="8" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,84">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Message}" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource LinkButton}"
                        Foreground="#93C5FD" FontWeight="SemiBold" Margin="16,0,0,0" Focusable="False"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
