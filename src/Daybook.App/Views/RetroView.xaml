<UserControl x:Class="Daybook.App.Views.RetroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Daybook.App.ViewModels"
             xmlns:m="clr-namespace:Daybook.App.Models"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RetroViewModel}"
             x:Name="Root">
    <UserControl.Resources>
        <!-- One subject: [discussed checkbox] text + date [delete] -->
        <DataTemplate x:Key="ItemRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="2,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox IsChecked="{Binding IsDiscussed}" VerticalAlignment="Top" Margin="2,6,6,0"
                              Focusable="False" Cursor="Hand" ToolTip="Discussed" />

                    <StackPanel Grid.Column="1">
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=Explicit}" FontSize="14" TextWrapping="Wrap"
                                 KeyDown="Text_KeyDown" LostKeyboardFocus="Text_LostKeyboardFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource InlineEdit}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiscussed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding AddedText}" FontSize="11" Margin="2,0,0,2"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button x:Name="DeleteButton" Grid.Column="2" ToolTip="Delete" Opacity="0" VerticalAlignment="Top"
                            Style="{StaticResource LinkButton}" Foreground="{StaticResource TextSecondaryBrush}"
                            Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource IconOnly}" Text="{StaticResource Icon.Close}" FontSize="11" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceTertiaryBrush}" />
                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One column: header, its own add box, its items -->
        <DataTemplate x:Key="Column" DataType="{x:Type vm:RetroColumnViewModel}">
            <StackPanel Margin="0,0,24,0">
                <TextBlock Margin="2,0,0,8" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                    <Run FontFamily="{StaticResource IconFont}" FontSize="14">
                        <Run.Style>
                            <Style TargetType="Run">
                                <Setter Property="Text" Value="{StaticResource Icon.Like}" />
                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RetroKind.DidNotGoWell}">
                                        <Setter Property="Text" Value="{StaticResource Icon.Dislike}" />
                                        <Setter Property="Foreground" Value="{StaticResource OverBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RetroKind.Idea}">
                                        <Setter Property="Text" Value="{StaticResource Icon.Lightbulb}" />
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Run.Style>
                    </Run>
                    <Run Text="{Binding Title, Mode=OneWay}" />
                </TextBlock>

                <!-- Add box: Enter adds to this column -->
                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="AddBox" Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="6,5" VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding Placeholder}" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=AddBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRow}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- No right margin: each column's own 24px gap gives the last one its page margin -->
    <Grid Margin="24,16,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Next retro" Style="{StaticResource PageTitle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding Columns}" ItemTemplate="{StaticResource Column}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- After the retro: only shows once something is ticked -->
        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,24,0"
                Content="{Binding ClearLabel}" Command="{Binding ClearDiscussedCommand}" Style="{StaticResource LinkButton}"
                Visibility="{Binding HasDiscussed, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
