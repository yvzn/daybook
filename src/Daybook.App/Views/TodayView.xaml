<UserControl x:Class="Daybook.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Daybook.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:TodayViewModel}"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Megaphone: grey when private, blue when shared -->
        <Style x:Key="ShareToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Share at standup" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="6,2">
                            <TextBlock x:Name="Icon" Style="{StaticResource IconOnly}" Text="{StaticResource Icon.Megaphone}"
                                       FontSize="16" Foreground="{StaticResource TextTertiaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One task: [checkbox] title [megaphone] [start/stop] [delete] -->
        <DataTemplate x:Key="TaskRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="4,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center" Margin="2,0,8,0"
                              Focusable="False" Cursor="Hand" ToolTip="Done" />

                    <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=Explicit}"
                             KeyDown="Title_KeyDown" LostKeyboardFocus="Title_LostKeyboardFocus">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource InlineEdit}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <ToggleButton Grid.Column="2" IsChecked="{Binding IsShared}" Style="{StaticResource ShareToggle}" />

                    <Button Grid.Column="3" Style="{StaticResource LinkButton}" MinWidth="72"
                            Visibility="{Binding IsPlanned, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Icon.Play}" FontSize="11" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource LinkButton}" MinWidth="72"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Visibility="{Binding IsDoing, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Icon.Stop}" FontSize="11" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="DeleteButton" Grid.Column="4" ToolTip="Delete" Opacity="0"
                            Style="{StaticResource LinkButton}" Foreground="{StaticResource TextSecondaryBrush}"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource IconOnly}" Text="{StaticResource Icon.Close}" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceTertiaryBrush}" />
                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" FontSize="15" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="Today" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <!-- New day: a banner, not a popup. "Later" leaves everything as it is. -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,10" CornerRadius="8"
                Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Later" Command="{Binding DismissBannerCommand}" Style="{StaticResource LinkButton}"
                            Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <Button Content="Start" Command="{Binding StartCheckupCommand}" Style="{StaticResource PrimaryButton}"
                            FontSize="14" Padding="16,6" />
                </StackPanel>
                <TextBlock FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                    <Run Text="{StaticResource Icon.Sun}" FontFamily="{StaticResource IconFont}" FontSize="16"
                         Foreground="{StaticResource WarnBrush}" />
                    <Run Text=" New day. Review yesterday's tasks? (1 min)" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Task list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                      Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <!-- Add box: always there, focused, Enter adds to Planned -->
                <Grid>
                    <TextBox x:Name="AddBox" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" Padding="8,7" VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Add a task…" FontSize="16" Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=AddBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Text="Nothing yet. What's on your plate today?" FontSize="15" Margin="2,24,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <DockPanel Visibility="{Binding HasDoing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Doing" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding FocusHint}" Style="{StaticResource SectionLabel}"
                               Foreground="{StaticResource WarnBrush}" Margin="12,16,0,6" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Doing}" ItemTemplate="{StaticResource TaskRow}" />

                <TextBlock Text="Planned" Style="{StaticResource SectionLabel}"
                           Visibility="{Binding HasPlanned, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Planned}" ItemTemplate="{StaticResource TaskRow}" />

                <TextBlock Text="Done" Style="{StaticResource SectionLabel}"
                           Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource TaskRow}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Morning check-up: replaces the list while open -->
        <Grid Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding Checkup}"
              Visibility="{Binding DataContext.IsCheckupOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding StepTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Grid.Row="1" Text="{Binding StepHint}" FontSize="14" Margin="0,4,0,12"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                        <Run Text="{Binding Task.Title, Mode=OneWay}" />
                                        <Run FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource AccentBrush}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Text" Value="" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Task.IsShared}" Value="True">
                                                            <Setter Property="Text" Value="{StaticResource Icon.Megaphone}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                    <ListBox ItemsSource="{Binding Options}" SelectedValuePath="Choice"
                                             SelectedValue="{Binding Choice}" ItemContainerStyle="{StaticResource PillItem}"
                                             BorderThickness="0" Background="Transparent" Margin="0,6,0,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <DockPanel Grid.Row="3" Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="140" />
                <Button Content="Later" Command="{Binding LaterCommand}" Style="{StaticResource LinkButton}"
                        Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
