<UserControl x:Class="Daybook.App.Views.SharedEarlierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Daybook.App.ViewModels"
             xmlns:views="clr-namespace:Daybook.App.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SharedEarlierViewModel}"
             x:Name="Root">
    <UserControl.Resources>
        <!-- One shared subject: text, date (click to change), outcome; hover: Not discussed, ✕ -->
        <DataTemplate x:Key="SharedRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="2,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Text="{Binding Text, UpdateSourceTrigger=Explicit}" Style="{StaticResource InlineEdit}"
                             FontSize="14" TextWrapping="Wrap"
                             KeyDown="Text_KeyDown" LostKeyboardFocus="Required_LostKeyboardFocus" />

                    <!-- Outcome: shows when set, or on hover to add one -->
                    <DockPanel Grid.Row="1" Margin="14,0,0,2">
                        <TextBlock Text="→" FontSize="13" Margin="0,3,4,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Text="{Binding Outcome, UpdateSourceTrigger=Explicit}" Tag="+ Add outcome" FontSize="13"
                                 TextWrapping="Wrap" KeyDown="Text_KeyDown" LostKeyboardFocus="Optional_LostKeyboardFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource AddLine}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOutcome}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </DockPanel>

                    <Button x:Name="NotDiscussedButton" Grid.Column="1" Content="Not discussed" Opacity="0" VerticalAlignment="Top"
                            Style="{StaticResource LinkButton}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                            ToolTip="Back to the next 1:1"
                            Command="{Binding DataContext.NotDiscussedCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Content="{Binding DateText}" VerticalAlignment="Top" FontSize="12"
                            Style="{StaticResource LinkButton}" Foreground="{StaticResource TextSecondaryBrush}"
                            ToolTip="Change date" Click="Date_Click" />
                    <Button x:Name="DeleteButton" Grid.Column="3" ToolTip="Delete" Opacity="0" VerticalAlignment="Top"
                            Style="{StaticResource LinkButton}" Foreground="{StaticResource TextSecondaryBrush}"
                            Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource IconOnly}" Text="{StaticResource Icon.Close}" FontSize="11" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceTertiaryBrush}" />
                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                    <Setter TargetName="NotDiscussedButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Command="{Binding BackCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,0,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Icon.Back}" />
                <TextBlock Text="{Binding BackLabel}" />
            </StackPanel>
        </Button>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyCommand}" Style="{StaticResource LinkButton}"
                    VerticalAlignment="Center" ToolTip="Copy as plain text, for an email or the review tool" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="No objectives this semester." FontSize="14" Margin="2,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding HasObjectives, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SharedGroupViewModel}">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Objective.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,2" />
                                <TextBlock Text="Nothing shared yet" FontSize="13" FontStyle="Italic" Margin="4,2,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Shared}" ItemTemplate="{StaticResource SharedRow}" Focusable="False" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- A forgotten win: same add box as the 1:1 page, objectives only. Dated today, click the date to change it -->
        <views:QuickAddBar Grid.Row="3" DataContext="{Binding Add}" Margin="0,12,0,0"
                           Visibility="{Binding DataContext.CanAdd, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />

        <!-- Footer: older semesters, and the rare "next semester" step right after the review -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Start new semester" Command="{Binding StartNewSemesterCommand}"
                    Style="{StaticResource LinkButton}" Foreground="{StaticResource TextSecondaryBrush}"
                    ToolTip="Objectives carry over; this semester stays readable from here"
                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding HasPastSemesters, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Past semesters:" FontSize="14" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding PastSemesters}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource LinkButton}"
                                    Command="{Binding DataContext.OpenSemesterCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DockPanel>

        <!-- Change a date: calendar at the mouse, one click picks it -->
        <Popup x:Name="DatePopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfacePrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <StackPanel>
                    <TextBlock Text="Shared on" Style="{StaticResource SectionLabel}" Margin="4,0,0,6" />
                    <Calendar x:Name="DateCalendar" SelectedDatesChanged="DateCalendar_SelectedDatesChanged"
                              PreviewMouseUp="DateCalendar_PreviewMouseUp" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
