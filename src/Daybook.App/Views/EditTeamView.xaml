<UserControl x:Class="Daybook.App.Views.EditTeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:vm="clr-namespace:Daybook.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:EditTeamViewModel}"
             x:Name="Root">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Style="{StaticResource LinkButton}" Margin="-6,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Icon.Back}" />
                    <TextBlock Text="Back to standup" />
                </StackPanel>
            </Button>
            <TextBlock Text="Edit team" Style="{StaticResource PageTitle}" HorizontalAlignment="Right" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,10">
            <TextBlock Text="Meeting length" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBox Text="{Binding Team.MeetingMinutes, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="10,0,6,0"
                     FontSize="15" Padding="4,2" HorizontalContentAlignment="Center" />
            <TextBlock Text="min" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding Team.Members}" ItemContainerStyle="{StaticResource EditableRow}"
                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource IconOnly}" Text="{StaticResource Icon.Gripper}" FontSize="14"
                                   Foreground="{StaticResource TextTertiaryBrush}" Background="Transparent" Cursor="SizeAll"
                                   Margin="4,0,10,0" ToolTip="Drag to reorder" />

                        <TextBox Grid.Column="1" Style="{StaticResource InlineEdit}" dd:DragDrop.DragSourceIgnore="True"
                                 Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                                 KeyDown="Name_KeyDown" LostKeyboardFocus="Name_LostKeyboardFocus" />

                        <!-- "Off until Fri 31 ✕": set from the standup screen, cleared here -->
                        <Border Grid.Column="2" Background="{StaticResource SurfaceTertiaryBrush}" CornerRadius="10"
                                Padding="10,2,2,2" Margin="8,0,0,0" VerticalAlignment="Center" dd:DragDrop.DragSourceIgnore="True"
                                Visibility="{Binding IsOff, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding OffLabel}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Button ToolTip="Back now" Style="{StaticResource LinkButton}"
                                        Foreground="{StaticResource TextSecondaryBrush}" Padding="6,0"
                                        Command="{Binding DataContext.ClearOffCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <TextBlock Style="{StaticResource IconOnly}" Text="{StaticResource Icon.Close}" FontSize="9" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="3" ToolTip="Remove"
                                Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,4,0"
                                dd:DragDrop.DragSourceIgnore="True"
                                Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <TextBlock Style="{StaticResource IconOnly}" Text="{StaticResource Icon.Close}" FontSize="12" />
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Add box: always there, focused, Enter adds -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="8,0,0,0" />
            <Grid>
                <TextBox x:Name="AddBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" Padding="8,7" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Add teammate…" FontSize="16" Margin="11,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=AddBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <TextBlock Grid.Row="4" Text="{Binding DuplicateHint}" Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="13" Margin="2,6,0,0" MinHeight="18" />
    </Grid>
</UserControl>
