<UserControl x:Class="Daybook.App.Views.EditObjectivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:vm="clr-namespace:Daybook.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:EditObjectivesViewModel}"
             x:Name="Root">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Style="{StaticResource LinkButton}" Margin="-6,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Icon.Back}" />
                    <TextBlock Text="Back to 1:1" />
                </StackPanel>
            </Button>
            <TextBlock Text="Objectives" Style="{StaticResource PageTitle}" HorizontalAlignment="Right" />
        </DockPanel>

        <!-- Semester label: click to rename ("S2 2026" is only a guess from the date) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,10">
            <TextBlock Text="Semester" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBox Text="{Binding Semester.Label, UpdateSourceTrigger=Explicit}" Style="{StaticResource InlineEdit}"
                     FontSize="15" MinWidth="80" Margin="10,0,0,0" ToolTip="Click to rename · Press Enter ↵ to save"
                     KeyDown="Text_KeyDown" LostKeyboardFocus="Text_LostKeyboardFocus" />
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding Semester.Objectives}" ItemContainerStyle="{StaticResource EditableRow}"
                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource IconOnly}" Text="{StaticResource Icon.Gripper}" FontSize="14"
                                   Foreground="{StaticResource TextTertiaryBrush}" Background="Transparent" Cursor="SizeAll"
                                   Margin="4,0,10,0" ToolTip="Drag to reorder" />

                        <TextBox Grid.Column="1" Style="{StaticResource InlineEdit}" dd:DragDrop.DragSourceIgnore="True"
                                 Text="{Binding Title, UpdateSourceTrigger=Explicit}" TextWrapping="Wrap"
                                 KeyDown="Text_KeyDown" LostKeyboardFocus="Text_LostKeyboardFocus" />

                        <Button Grid.Column="2" ToolTip="Remove (with its subjects)"
                                Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,4,0"
                                dd:DragDrop.DragSourceIgnore="True"
                                Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <TextBlock Style="{StaticResource IconOnly}" Text="{StaticResource Icon.Close}" FontSize="12" />
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Add box: always there, focused, Enter adds -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="8,0,0,0" />
            <Grid>
                <TextBox x:Name="AddBox" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" Padding="8,7" VerticalContentAlignment="Center"
                         ToolTip="{StaticResource Hint.EnterToAdd}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Add objective…" FontSize="16" Margin="11,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=AddBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
